---
import { ArrowRight } from 'lucide-react'
import { featuredProjects, otherProjects } from '../../data/projects.js'

// Projects — layout alternado para destacados, grid 3 cols para otros
---

<section id="projects" tabindex="-1" aria-labelledby="projects-title" class="py-20">
  <div class="container-custom">
    <!-- Título principal -->
    <h2 id="projects-title" class="section-heading text-center mb-4">Proyectos</h2>
    <p
      class="text-base text-(--text-secondary) text-center max-w-3xl mx-auto mb-14 leading-relaxed"
    >
      Selección de proyectos de UX/UI y producto digital donde participé en investigación,
      estructura de información, diseño de interfaces y definición visual para experiencias web y
      móviles.
    </p>

    <!-- Proyectos destacados -->
    {
      featuredProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Destacados</h3>
          <ul class="flex flex-col gap-16 mb-24" role="list" aria-label="Proyectos destacados">
            {featuredProjects.map((project, index) => (
              <li>
                <article
                  class={`featured-row${index % 2 !== 0 ? ' featured-row--reverse' : ''}`}
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Columna imagen */}
                  <div class="featured-image-col">
                    <div class="featured-image-frame">
                      {project.image ? (
                        <img
                          src={project.image}
                          alt={project.imageAlt}
                          class="featured-img"
                          loading="lazy"
                        />
                      ) : (
                        <div class="featured-img-placeholder">Imagen próximamente</div>
                      )}
                    </div>
                  </div>

                  {/* Columna texto */}
                  <div class="featured-text-col">
                    <p class="featured-kicker">
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <span aria-hidden="true"> / </span>
                      <span>{project.type}</span>
                    </p>
                    <h4 class="featured-title">{project.title}</h4>
                    <p class="featured-desc">{project.description}</p>
                    <div class="featured-actions">
                      {project.reference ? (
                        <p class="featured-ref">Referencia: {project.reference}</p>
                      ) : (
                        <span />
                      )}
                      {project.demo ? (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="featured-btn"
                          aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      ) : (
                        <span class="featured-btn featured-btn--disabled">
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <!-- Otros proyectos -->
    {
      otherProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Otros proyectos</h3>
          <ul class="other-grid" role="list" aria-label="Otros proyectos">
            {otherProjects.map((project) => (
              <li class="other-item flex">
                <article
                  class="other-card flex flex-col w-full rounded-xl overflow-hidden bg-(--surface-secondary)"
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Imagen */}
                  <div class="other-image-wrap">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.imageAlt}
                        class="w-full h-full"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-(--text-secondary) text-xs opacity-40">
                        Imagen próximamente
                      </div>
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="p-5 flex flex-col flex-1 gap-3">
                    <h4
                      class="text-xl font-normal leading-tight"
                      style={`font-family: 'Fanwood Text', Georgia, serif; color: ${project.accentColor};`}
                    >
                      {project.title}
                    </h4>
                    <p class="text-sm text-(--text-primary) leading-relaxed flex-1 line-clamp-3">
                      {project.shortDescription}
                    </p>
                    <div class="mt-auto flex items-center justify-between gap-3">
                      {project.reference ? (
                        <p class="text-xs text-(--text-secondary)">
                          Referencia: {project.reference}
                        </p>
                      ) : (
                        <span />
                      )}
                      {project.demo ? (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium transition-opacity hover:opacity-85 shrink-0"
                          style={`background-color: ${project.accentColor};`}
                          aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      ) : (
                        <span
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium opacity-60 cursor-default shrink-0"
                          style={`background-color: ${project.accentColor};`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div class="carousel-dots lg:hidden" aria-hidden="true">
            {otherProjects.map((_, i) => (
              <span class={`carousel-dot${i === 0 ? ' active' : ''}`} data-dot={i} />
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  /* ── Featured projects: editorial layout ─────────────── */
  .featured-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .featured-row--reverse .featured-image-col {
    order: 2;
  }
  .featured-row--reverse .featured-text-col {
    order: 1;
  }

  .featured-image-frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .featured-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--text-secondary);
    opacity: 0.4;
  }

  .featured-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .featured-kicker {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .featured-title {
    font-family: 'Fanwood Text', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-secondary);
  }

  .featured-desc {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    color: var(--text-primary);
    line-height: 1.7;
    max-width: 48ch;
  }

  .featured-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 1rem;
    border-radius: var(--radius-lg);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    background-color: var(--color-secondary);
    color: #ffffff;
    text-decoration: none;
    align-self: flex-end;
    transition: opacity 150ms ease;
  }

  :root[data-theme='dark'] .featured-btn {
    background-color: var(--color-primary);
    color: var(--surface-primary);
  }

  .featured-btn:hover {
    opacity: 0.85;
  }

  .featured-btn--disabled {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
  }

  .featured-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .featured-ref {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: -0.5rem;
  }

  /* Mobile: card unificada */
  @media (max-width: 767px) {
    .featured-row,
    .featured-row--reverse {
      grid-template-columns: 1fr;
      gap: 0;
      background: var(--surface-secondary);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }

    .featured-row--reverse .featured-image-col,
    .featured-row--reverse .featured-text-col {
      order: unset;
    }

    .featured-image-frame {
      border-radius: 0;
      aspect-ratio: 3 / 2;
    }

    .featured-img {
      object-fit: inherit;
      object-position: center center;
      background-color: var(--surface-secondary);
    }

    .featured-text-col {
      padding: 1.25rem;
      gap: 0.75rem;
    }

    .featured-title {
      font-size: clamp(1.75rem, 7vw, 2.5rem);
    }

    .featured-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .featured-actions .featured-ref {
      margin-top: 0;
    }

    .featured-actions .featured-btn {
      align-self: auto;
      flex-shrink: 0;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .featured-row {
      gap: 2.5rem;
    }
  }

  /* Imagen de otros proyectos */
  .other-image-wrap {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background-color: var(--surface-secondary);
  }

  .other-image-wrap img {
    object-fit: cover;
    object-position: center top;
  }

  /* Carrusel mobile */
  .other-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 1rem;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }

  .other-grid::-webkit-scrollbar {
    display: none;
  }

  .other-item {
    flex: 0 0 80vw;
    max-width: 320px;
    scroll-snap-align: start;
  }

  /* Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 1rem;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.4;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .carousel-dot.active {
    opacity: 1;
    transform: scale(1.3);
    background: var(--color-secondary);
  }

  /* A partir de lg: grid normal */
  @media (min-width: 1024px) {
    .other-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }

    .other-item {
      flex: unset;
      max-width: unset;
      scroll-snap-align: none;
    }
  }
</style>

<script>
  const grid = document.querySelector('.other-grid')
  const dots = document.querySelectorAll('.carousel-dot')

  if (grid && dots.length) {
    grid.addEventListener(
      'scroll',
      () => {
        const index = Math.round(grid.scrollLeft / grid.offsetWidth)
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index))
      },
      { passive: true }
    )
  }
</script>
