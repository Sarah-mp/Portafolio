---
import { ArrowRight } from 'lucide-react'
import { featuredProjects, otherProjects } from '../../data/projects.js'

// Projects — layout alternado para destacados, grid 3 cols para otros
---

<section id="projects" tabindex="-1" aria-label="Proyectos" class="py-20">
  <div class="container-custom">
    <!-- Título principal -->
    <h2 class="section-heading text-center mb-4">Proyectos</h2>

    <!-- Proyectos destacados -->
    {
      featuredProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Destacados</h3>
          <ul class="flex flex-col gap-16 mb-24" role="list" aria-label="Proyectos destacados">
            {featuredProjects.map((project, index) => (
              <li>
                <article
                  class={`grid lg:grid-cols-2 gap-8 items-center ${index % 2 !== 0 ? 'lg:[direction:rtl]' : ''}`}
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Tarjeta imagen */}
                  <div
                    class={`featured-card bg-(--surface-secondary) rounded-xl overflow-hidden ${index % 2 !== 0 ? 'lg:[direction:ltr]' : ''}`}
                  >
                    {project.image ? (
                      <div class="project-image-wrap">
                        <img
                          src={project.image}
                          alt={`Captura del proyecto ${project.title}`}
                          class="w-full h-full"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="project-image-wrap flex items-center justify-center text-(--text-secondary) text-sm opacity-40">
                        Imagen próximamente
                      </div>
                    )}
                    <div class="p-5">
                      <h4
                        class="text-2xl font-normal mb-2"
                        style={`font-family: 'Fanwood Text', Georgia, serif; color: ${project.accentColor};`}
                      >
                        {project.title}
                      </h4>
                      <p class="text-sm text-(--text-primary) mb-3">{project.shortDescription}</p>
                      {project.reference && (
                        <p class="text-xs text-(--text-secondary) mb-4">
                          Referencia: {project.reference}
                        </p>
                      )}
                      {project.demo && (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium transition-opacity duration-150 hover:opacity-85"
                          style={`background-color: ${project.accentColor};`}
                          aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      )}
                      {!project.demo && (
                        <span
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium opacity-60 cursor-default"
                          style={`background-color: ${project.accentColor};`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Descripción larga */}
                  <div class={index % 2 !== 0 ? 'lg:[direction:ltr]' : ''}>
                    <p class="text-xl md:text-2xl text-(--text-primary) leading-relaxed">
                      {project.description}
                    </p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <!-- Otros proyectos -->
    {
      otherProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Otros proyectos</h3>
          <ul
            class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
            role="list"
            aria-label="Otros proyectos"
          >
            {otherProjects.map((project) => (
              <li>
                <article
                  class="other-card flex flex-col rounded-xl overflow-hidden bg-(--surface-secondary)"
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Imagen */}
                  <div class="other-image-wrap">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={`Captura del proyecto ${project.title}`}
                        class="w-full h-full"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-(--text-secondary) text-xs opacity-40">
                        Imagen próximamente
                      </div>
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="p-5 flex flex-col flex-1 gap-3">
                    <h4
                      class="text-xl font-normal leading-tight"
                      style={`font-family: 'Fanwood Text', Georgia, serif; color: ${project.accentColor};`}
                    >
                      {project.title}
                    </h4>
                    <p class="text-sm text-(--text-primary) leading-relaxed flex-1">
                      {project.shortDescription}
                    </p>
                    <div class="mt-auto">
                      {project.demo ? (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium transition-opacity hover:opacity-85"
                          style={`background-color: ${project.accentColor};`}
                          aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      ) : (
                        <span
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium opacity-60 cursor-default"
                          style={`background-color: ${project.accentColor};`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  /* Imagen de proyectos destacados */
  .project-image-wrap {
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  /* Imagen de otros proyectos */
  .other-image-wrap {
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  /* Reset direction RTL solo para desktop */
  @media (max-width: 1023px) {
    article[class*='rtl'] {
      direction: ltr;
    }
  }
</style>
