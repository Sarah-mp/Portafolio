---
const steps = [
  {
    title: 'Investigación',
    description: 'Entrevistas, requisitos',
    icon: '/icons/investigation.svg',
  },
  {
    title: 'Prototipos',
    description: 'Prototipos en Figma',
    icon: '/icons/prototype.svg',
  },
  {
    title: 'Diseños finales',
    description: 'Diseños ya definidos de las interfaces',
    icon: '/icons/final-designs.svg',
  },
  {
    title: 'Validación',
    description: 'Pruebas de usabilidad',
    icon: '/icons/validation.svg',
  },
]
---

<section id="process" tabindex="-1" aria-labelledby="process-title" class="py-20">
  <div class="container-custom">
    <h2 id="process-title" class="section-heading text-center mb-4">Proceso de diseño</h2>
    <p
      class="text-base text-(--text-secondary) text-center max-w-3xl mx-auto mb-16 leading-relaxed"
    >
      Mi proceso combina investigación, definición visual y validación para construir experiencias
      útiles, comprensibles y alineadas con los objetivos del producto.
    </p>

    <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" aria-label="Pasos del proceso de diseño">
      {
        steps.map((step) => (
          <li class="flex flex-col items-center text-center gap-5">
            {/* Icono grande */}
            <div class="process-icon-wrap">
              <img src={step.icon} alt="" aria-hidden="true" class="process-icon-img" />
            </div>

            {/* Título */}
            <h3 class="process-step-title">{step.title}</h3>

            {/* Separador */}
            <hr class="process-divider" aria-hidden="true" />

            {/* Descripción */}
            <p class="text-sm text-(--text-secondary) leading-relaxed">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .process-icon-img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
  }

  .process-step-title {
    font-family: 'Fanwood Text', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--color-secondary);
    line-height: 1.1;
  }

  .process-divider {
    width: 100%;
    border: none;
    border-top: 1.5px solid var(--color-secondary);
    opacity: 0.4;
  }
</style>
