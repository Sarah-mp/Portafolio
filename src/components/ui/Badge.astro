---
import { Sparkles } from 'lucide-react'

// Badge — etiqueta pequeña usada sobre los títulos de sección
// Uso: <Badge>Proyectos</Badge>
interface Props {
  className?: string
}

const { className = '' } = Astro.props
---

<span
  class:list={[
    'inline-flex items-center gap-2 text-xs uppercase tracking-widest font-medium text-(--color-primary)',
    className,
  ]}
>
  <Sparkles className="w-3.5 h-3.5" aria-hidden="true" />
  <slot />
</span>
