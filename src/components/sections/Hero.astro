---
import { Linkedin, Mail } from 'lucide-react'

// Hero — sección principal con foto oval y presentación
// Dos columnas: izquierda foto oval, derecha texto + pills
---

<section
  id="hero"
  tabindex="-1"
  aria-label="Presentación"
  class="min-h-screen flex items-center pt-28 pb-20"
>
  <div class="container-custom">
    <!--
      Estrategia responsive:
      - Mobile: flex-col, cada elemento suelto con order
        orden: título(1) → subtítulo(2) → foto(3) → bio(4) → pills(5)
      - md+: grid 2 cols, foto col-1 rows 1-4, textos col-2
    -->
    <div
      class="flex flex-col items-center text-center md:grid md:grid-cols-[40%_60%] md:gap-8 md:items-center md:text-left [&>*]:min-w-0"
    >
      <!-- FOTO — order-3 mobile, row-span en md -->
      <div
        class="flex justify-center md:justify-start mb-6 md:mb-0 order-3 md:order-none md:row-span-4"
      >
        <div class="oval-photo-wrapper" aria-hidden="true">
          <img
            src="/img/sarah-profile.png"
            alt="Foto de perfil de Sarah Murcia"
            class="oval-photo"
            loading="eager"
          />
        </div>
      </div>

      <!-- TÍTULO — order-1 mobile -->
      <h1 class="hero-name mb-4 order-1 md:order-none w-full min-w-0">Hola! Sarah Murcia</h1>

      <!-- SUBTÍTULO — order-2 mobile -->
      <div
        class="hero-subtitle mb-6 order-2 md:order-none w-full"
        aria-label="UX/UI Design Junior & frontend junior"
      >
        <span class="hero-subtitle-line" aria-hidden="true"></span>
        <span class="hero-subtitle-text">UX/UI Design Junior &amp; frontend junior</span>
        <span class="hero-subtitle-line" aria-hidden="true"></span>
      </div>

      <!-- BIO — order-4 mobile -->
      <p
        class="text-base text-(--text-secondary) leading-relaxed w-full mb-10 order-4 md:order-none"
      >
        Creamos narrativas digitales mediante una estética cuidada y una lógica centrada en el
        usuario. Nuestras creaciones se basan en la fusión del diseño inspirado en la tradición y la
        ejecución técnica moderna.
      </p>

      <!-- PILLS — order-5 mobile -->
      <div
        class="flex flex-wrap items-center justify-center gap-3 w-full order-5 md:order-none"
        role="list"
        aria-label="Canales de contacto"
      >
        <a
          href="https://www.linkedin.com/in/sarah-murcia-prado-943435274/"
          target="_blank"
          rel="noopener noreferrer"
          role="listitem"
          class="contact-pill"
          aria-label="LinkedIn de Sarah Murcia (abre en nueva pestaña)"
        >
          <Linkedin className="w-4 h-4" aria-hidden="true" />
          <span>Linkedin</span>
        </a>
        <a
          href="mailto:sarah.murciapr@gmail.com"
          role="listitem"
          class="contact-pill"
          aria-label="Enviar email a Sarah Murcia"
        >
          <Mail className="w-4 h-4" aria-hidden="true" style={{ color: '#512907' }} />
          <span>Email</span>
        </a>
        <a
          href="https://wa.me/573205782884"
          target="_blank"
          rel="noopener noreferrer"
          role="listitem"
          class="contact-pill"
          aria-label="Contactar a Sarah Murcia por WhatsApp (abre en nueva pestaña)"
        >
          <img src="/icons/whatsapp.svg" alt="" aria-hidden="true" class="w-4 h-4 icon-svg" />
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Foto oval con borde marrón claro */
  .oval-photo-wrapper {
    width: 220px;
    height: 280px;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .oval-photo-wrapper {
      width: 260px;
      height: 330px;
    }
  }

  @media (min-width: 1024px) {
    .oval-photo-wrapper {
      width: 320px;
      height: 410px;
    }
  }

  .oval-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Nombre principal — Crimson Pro grande */
  .hero-name {
    font-family: 'Fanwood Text', Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 5rem);
    font-weight: 400;
    color: var(--color-secondary);
    line-height: 1.05;
    text-align: center;
  }

  /* Subtítulo con líneas laterales */
  .hero-subtitle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-subtitle-line {
    flex: 0.1;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.4;
    min-width: 4px;
  }

  .hero-subtitle-text {
    font-family: 'Fanwood Text', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    color: var(--color-primary);
    text-align: center;
    flex-shrink: 1;
  }

  /* Pills outline estilo Figma */
  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-secondary);
    background: transparent;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      color 150ms ease,
      background-color 150ms ease;
  }

  /* LinkedIn pill: filled (primer pill) */
  .contact-pill:first-child {
    background: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--surface-primary);
  }

  .contact-pill:first-child:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .contact-pill:not(:first-child):hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--card-glow-1);
  }

  .contact-pill:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
