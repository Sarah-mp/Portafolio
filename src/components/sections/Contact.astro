---
import SectionTitle from '../ui/SectionTitle.astro'
import ContactForm from '../ContactForm.jsx'
import { Linkedin, Mail, MessageCircle } from 'lucide-react'

// Contact — sección de contacto
// Izquierda: texto + links directos (LinkedIn, Email, WhatsApp)
// Derecha: formulario React (client:load para hidratación inmediata)
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT
---

<section id="contact" tabindex="-1" aria-label="Contacto" class="py-20 bg-(--surface-secondary)">
  <div class="container-custom">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-start">
      <!-- Columna izquierda: texto + links -->
      <div>
        <SectionTitle
          badge="Contacto"
          title="Hablemos"
          subtitle="¿Tienes un proyecto en mente o quieres colaborar? Escríbeme, respondo rápido."
        />

        <nav aria-label="Canales de contacto directo" class="flex flex-col gap-3">
          <a
            href="https://linkedin.com/in/sarah-murcia"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-direct-link"
            aria-label="LinkedIn de Sarah Murcia (abre en nueva pestaña)"
          >
            <span class="contact-direct-icon">
              <Linkedin className="w-4 h-4" aria-hidden="true" />
            </span>
            <div>
              <p class="text-xs text-(--text-secondary) uppercase tracking-wider mb-0.5">
                LinkedIn
              </p>
              <p class="text-sm text-(--text-primary)">Sarah Murcia</p>
            </div>
          </a>

          <a
            href="mailto:sarah@email.com"
            class="contact-direct-link"
            aria-label="Enviar email a Sarah Murcia"
          >
            <span class="contact-direct-icon">
              <Mail className="w-4 h-4" aria-hidden="true" />
            </span>
            <div>
              <p class="text-xs text-(--text-secondary) uppercase tracking-wider mb-0.5">Email</p>
              <p class="text-sm text-(--text-primary)">sarah@email.com</p>
            </div>
          </a>

          <a
            href="https://wa.me/573000000000"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-direct-link"
            aria-label="Contactar por WhatsApp (abre en nueva pestaña)"
          >
            <span class="contact-direct-icon">
              <MessageCircle className="w-4 h-4" aria-hidden="true" />
            </span>
            <div>
              <p class="text-xs text-(--text-secondary) uppercase tracking-wider mb-0.5">
                WhatsApp
              </p>
              <p class="text-sm text-(--text-primary)">+57 300 000 0000</p>
            </div>
          </a>
        </nav>
      </div>

      <!-- Columna derecha: formulario -->
      <div>
        <ContactForm client:load endpoint={formspreeEndpoint} />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-direct-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
    text-decoration: none;
  }

  .contact-direct-link:hover {
    border-color: var(--color-accent);
    background: var(--card-glow-1);
  }

  .contact-direct-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .contact-direct-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--surface-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    shrink: 0;
  }
</style>
