---
import { ArrowRight } from 'lucide-react'
import { featuredProjects, otherProjects } from '../../data/projects.js'

// Projects — layout alternado para destacados, grid 3 cols para otros
---

<section id="projects" tabindex="-1" aria-labelledby="projects-title" class="py-20">
  <div class="container-custom">
    <!-- Título principal -->
    <h2 id="projects-title" class="section-heading text-center mb-4">Proyectos</h2>
    <p
      class="text-base text-(--text-secondary) text-center max-w-3xl mx-auto mb-14 leading-relaxed"
    >
      Selección de proyectos de UX/UI y producto digital donde participé en investigación,
      estructura de información, diseño de interfaces y definición visual para experiencias web y
      móviles.
    </p>

    <!-- Proyectos destacados -->
    {
      featuredProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Destacados</h3>
          <ul class="flex flex-col gap-16 mb-24" role="list" aria-label="Proyectos destacados">
            {featuredProjects.map((project, index) => (
              <li>
                <article
                  class={`grid lg:grid-cols-2 gap-8 items-center ${index % 2 !== 0 ? 'lg:[direction:rtl]' : ''}`}
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Tarjeta imagen */}
                  <div
                    class={`featured-card bg-(--surface-secondary) rounded-xl overflow-hidden ${index % 2 !== 0 ? 'lg:[direction:ltr]' : ''}`}
                  >
                    {project.image ? (
                      <div class="project-image-wrap">
                        <img
                          src={project.image}
                          alt={project.imageAlt}
                          class="w-full h-full"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="project-image-wrap flex items-center justify-center text-(--text-secondary) text-sm opacity-40">
                        Imagen próximamente
                      </div>
                    )}
                    <div class="p-5">
                      <h4
                        class="text-2xl font-normal mb-2"
                        style={`font-family: 'Fanwood Text', Georgia, serif; color: ${project.accentColor};`}
                      >
                        {project.title}
                      </h4>
                      <p class="text-sm text-(--text-primary) mb-4">{project.shortDescription}</p>
                      <div class="flex items-center justify-between gap-3">
                        {project.reference ? (
                          <p class="text-xs text-(--text-secondary)">
                            Referencia: {project.reference}
                          </p>
                        ) : (
                          <span />
                        )}
                        {project.demo ? (
                          <a
                            href={project.demo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium transition-opacity duration-150 hover:opacity-85 shrink-0"
                            style={`background-color: ${project.accentColor};`}
                            aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                          >
                            Ver proyecto
                            <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                          </a>
                        ) : (
                          <span
                            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium opacity-60 cursor-default shrink-0"
                            style={`background-color: ${project.accentColor};`}
                          >
                            Ver proyecto
                            <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                          </span>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* Descripción larga */}
                  <div class={index % 2 !== 0 ? 'lg:[direction:ltr]' : ''}>
                    <p class="text-xl md:text-2xl text-(--text-primary) leading-relaxed">
                      {project.description}
                    </p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <!-- Otros proyectos -->
    {
      otherProjects.length > 0 && (
        <>
          <h3 class="section-heading-md text-center mb-12">Otros proyectos</h3>
          <ul class="other-grid" role="list" aria-label="Otros proyectos">
            {otherProjects.map((project) => (
              <li class="other-item flex">
                <article
                  class="other-card flex flex-col w-full rounded-xl overflow-hidden bg-(--surface-secondary)"
                  aria-label={`Proyecto: ${project.title}`}
                >
                  {/* Imagen */}
                  <div class="other-image-wrap">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.imageAlt}
                        class="w-full h-full"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-(--text-secondary) text-xs opacity-40">
                        Imagen próximamente
                      </div>
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="p-5 flex flex-col flex-1 gap-3">
                    <h4
                      class="text-xl font-normal leading-tight"
                      style={`font-family: 'Fanwood Text', Georgia, serif; color: ${project.accentColor};`}
                    >
                      {project.title}
                    </h4>
                    <p class="text-sm text-(--text-primary) leading-relaxed flex-1 line-clamp-3">
                      {project.shortDescription}
                    </p>
                    <div class="mt-auto flex items-center justify-between gap-3">
                      {project.reference ? (
                        <p class="text-xs text-(--text-secondary)">
                          Referencia: {project.reference}
                        </p>
                      ) : (
                        <span />
                      )}
                      {project.demo ? (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium transition-opacity hover:opacity-85 shrink-0"
                          style={`background-color: ${project.accentColor};`}
                          aria-label={`Ver proyecto ${project.title} (abre en nueva pestaña)`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      ) : (
                        <span
                          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm text-white font-medium opacity-60 cursor-default shrink-0"
                          style={`background-color: ${project.accentColor};`}
                        >
                          Ver proyecto
                          <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div class="carousel-dots sm:hidden" aria-hidden="true">
            {otherProjects.map((_, i) => (
              <span class={`carousel-dot${i === 0 ? ' active' : ''}`} data-dot={i} />
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  /* Imagen de proyectos destacados */
  .project-image-wrap {
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  /* Imagen de otros proyectos */
  .other-image-wrap {
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  /* Reset direction RTL solo para desktop */
  @media (max-width: 1023px) {
    article[class*='rtl'] {
      direction: ltr;
    }
  }

  /* Carrusel mobile */
  .other-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 1rem;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }

  .other-grid::-webkit-scrollbar {
    display: none;
  }

  .other-item {
    flex: 0 0 80vw;
    max-width: 320px;
    scroll-snap-align: start;
  }

  /* Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 1rem;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.4;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .carousel-dot.active {
    opacity: 1;
    transform: scale(1.3);
    background: var(--color-secondary);
  }

  /* A partir de sm: grid normal */
  @media (min-width: 640px) {
    .other-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }

    .other-item {
      flex: unset;
      max-width: unset;
      scroll-snap-align: none;
    }
  }

  @media (min-width: 1024px) {
    .other-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const grid = document.querySelector('.other-grid')
  const dots = document.querySelectorAll('.carousel-dot')

  if (grid && dots.length) {
    grid.addEventListener(
      'scroll',
      () => {
        const index = Math.round(grid.scrollLeft / grid.offsetWidth)
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index))
      },
      { passive: true }
    )
  }
</script>
