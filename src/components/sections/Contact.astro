---
// Contact — sección minimalista estilo Figma
// Tagline grande en italic + párrafo + email clickeable
---

<section id="contact" tabindex="-1" aria-label="Contacto" class="py-32 text-center">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="tagline-heading mb-10">Creemos algo significativo juntos.</h2>

    <p class="text-lg text-(--text-secondary) max-w-2xl mx-auto mb-12 leading-relaxed">
      Actualmente estoy abierta a cubrir puestos junior, colaboraciones como freelance y
      conversaciones sobre el futuro de la experiencia digital.
    </p>

    <a
      href="mailto:sarah.murciapr@gmail.com"
      class="contact-email-link"
      aria-label="Enviar email a Sarah Murcia"
    >
      sarah.murciapr@gmail.com
    </a>
  </div>
</section>

<style>
  .contact-email-link {
    font-family: 'Fanwood Text', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-secondary);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .contact-email-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .contact-email-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>
