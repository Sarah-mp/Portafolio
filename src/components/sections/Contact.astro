---
import SectionTitle from '../ui/SectionTitle.astro'
import { Linkedin, Mail, MessageCircle } from 'lucide-react'

// Contact — sección de contacto
// Links directos: LinkedIn, Email, WhatsApp
---

<section id="contact" tabindex="-1" aria-label="Contacto" class="py-20 bg-(--surface-secondary)">
  <div class="container-custom">
    <SectionTitle
      badge="Contacto"
      title="Hablemos"
      subtitle="¿Tienes un proyecto en mente o quieres colaborar? Escríbeme, respondo rápido."
      align="center"
    />

    <nav
      aria-label="Canales de contacto directo"
      class="flex flex-col sm:flex-row justify-center gap-4 mt-10"
    >
      <a
        href="https://linkedin.com/in/sarah-murcia"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-direct-link"
        aria-label="LinkedIn de Sarah Murcia (abre en nueva pestaña)"
      >
        <span class="contact-direct-icon">
          <Linkedin className="w-5 h-5" aria-hidden="true" />
        </span>
        <div>
          <p class="text-xs uppercase tracking-wider mb-0.5 opacity-70">LinkedIn</p>
          <p class="text-sm font-medium">Sarah Murcia</p>
        </div>
      </a>

      <a
        href="mailto:sarah@email.com"
        class="contact-direct-link"
        aria-label="Enviar email a Sarah Murcia"
      >
        <span class="contact-direct-icon">
          <Mail className="w-5 h-5" aria-hidden="true" />
        </span>
        <div>
          <p class="text-xs uppercase tracking-wider mb-0.5 opacity-70">Email</p>
          <p class="text-sm font-medium">sarah@email.com</p>
        </div>
      </a>

      <a
        href="https://wa.me/573000000000"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-direct-link"
        aria-label="Contactar por WhatsApp (abre en nueva pestaña)"
      >
        <span class="contact-direct-icon">
          <MessageCircle className="w-5 h-5" aria-hidden="true" />
        </span>
        <div>
          <p class="text-xs uppercase tracking-wider mb-0.5 opacity-70">WhatsApp</p>
          <p class="text-sm font-medium">+57 300 000 0000</p>
        </div>
      </a>
    </nav>
  </div>
</section>

<style>
  .contact-direct-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-secondary);
    color: #ffffff;
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    text-decoration: none;
    min-width: 200px;
  }

  .contact-direct-link:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .contact-direct-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .contact-direct-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
